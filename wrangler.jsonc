{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "edge-queue-connector",
    "main": "src/worker.js",
    "compatibility_date": "2025-09-04",
    "observability": {
        "enabled": true
    },
    "vars": {
        "DEBUG_MODE": "false",
        "API_BASE_URL": "https://clients.virtual-queue.com",
        "QUEUE_DOMAIN": "yourcompany.virtual-queue.com"
    },
    "kv_namespaces": [
        {
            "binding": "RULES_KV",
            "id": "<YOUR_KV_NAMESPACE_ID>"
        }
    ]
    // After deploying, add your routes here:
    // "routes": [
    //     {
    //         "pattern": "your-domain.com/*",
    //         "zone_name": "your-domain.com"
    //     }
    // ]
}